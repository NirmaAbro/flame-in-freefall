# Copy this file to .env and fill in the values. Never commit .env: the repo is public.
# Start the app with:  uvicorn app.main:app --env-file .env

# Frontend addresses that may call the API (comma separated).
CORS_ORIGINS=http://localhost:3000

# Supabase (database and file storage). Leave empty to run on sample data only.
SUPABASE_URL=
SUPABASE_KEY=

# Model provider, through an OpenAI-compatible chat API. DeepSeek is the default.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=
