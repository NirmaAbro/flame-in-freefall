# Copy this file to .env and fill in the values. Never commit .env: the repo is public.
# Start the app with:  uvicorn app.main:app --env-file .env

# Frontend addresses that may call the API (comma separated).
CORS_ORIGINS=http://localhost:3000

# Supabase (database and file storage). Leave empty to run on sample data only.
SUPABASE_URL=
SUPABASE_KEY=

# Model provider, through Google's OpenAI-compatible Gemini API.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Check the model name with: python -m scripts.check_llm
