# Copy this file to .env.local and adjust.

# true  -> the app uses the built-in dummy data (src/lib/mock). No backend needed.
# false -> the app calls the real FastAPI backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the IGNIS backend (only used when NEXT_PUBLIC_USE_MOCK=false).
# NEVER put the Gemini key or database credentials in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
